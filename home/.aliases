PATH=$PATH:/mnt/user/src/scripts:$HOME/.homesick/repos/homeshick:$HOME/.local/bin
LS_COLORS='di=1;31:fi=0:ln=31:pi=5:so=5:bd=5:cd=5:or=37:mi=0:ex=35:ow=1;95:*.rpm=90'
export LS_COLORS

alias dir="ls -alh --group-directories-first --color"
alias dirm="ls -alh --group-directories-first --color | more"
alias dirt="ls -altrh --group-directories-first --color --time-style=+%D | grep $(date +%D)"
alias ll='ls -lhF --color=auto'
alias llt='ls -lht --color=auto'
alias lla='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias ls="ls --color=auto"
alias vinginx='vi /mnt/user/appdata/letsencrypt/nginx/site-confs/default'
alias vi='vim'
alias backupConfig='/boot/config/backup.sh'
alias import='docker exec -it beets bash /config/beets.sh '
alias ipconfig='nmcli device show | grep IP4'
alias checkvpn='/mnt/user/src/scripts/checkvpn'
alias docker-compose='docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$PWD:$PWD" \
    -w="$PWD" \
    docker/compose:latest'
alias importMusic='docker exec -it beets /config/beets.sh /downloads'
alias importSoulseek='docker exec -it beets /config/beets.sh /soulseek'
alias countDirs='ls -d */ |wc -l'
alias countFiles='find $1 -type f | wc -l'
alias soulseek='docker exec -it bash'
alias dockerstats='docker stats --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}"'
alias immich="docker run -it --rm -v $(pwd):/import ghcr.io/immich-app/immich-cli:latest"
alias duSpace='du -h --max-depth=1 '
alias movePorn='mv /mnt/user/downloads/youtube/* /mnt/user/other/'
alias immichImportDir="docker run -it --rm -v $1:/import ghcr.io/immich-app/immich-cli:latest upload --key jhNQduN0Bh2PF7IyCCfDuxIyEgtnxJOzSYduEPc --server https://images.YerADonkey.com/api"
alias immichImport="docker run -it --rm -v $(pwd):/import ghcr.io/immich-app/immich-cli:latest upload --key jhNQduN0Bh2PF7IyCCfDuxIyEgtnxJOzSYduEPc --server https://images.YerADonkey.com/api"

# tmux aliases

alias nsh='ssh user@server "bash --norc --noprofile"'
alias cockpit-reset='~/tmux-cockpit.sh'

# Create-or-attach a dedicated tmux session for a workspace/agent pair.
# Uses switch-client (not attach) when already inside tmux (we always are,
# since .bashrc auto-attaches to "cockpit") to avoid nested-tmux sessions,
# which break mouse reporting / scroll / copy.
# The explicit `cd` (rather than relying on `new-session -c`) is required:
# /etc/profile does an unconditional `cd $HOME` on every shell startup,
# which would otherwise override the pane's starting directory.
_agent_tmux() {
  local name="$1" dir="$2" cmd="$3"

  if ! tmux has-session -t "=$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$dir"
    tmux send-keys -t "$name" "cd \"$dir\" && $cmd" C-m
  fi

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$name"
  else
    tmux attach -t "$name"
  fi
}

# Cursor agent — sysadmin workspaces on cache, each in its own tmux session
alias haAgent='_agent_tmux haAgent /mnt/cache/cursor-workspace/home-assistant agent'
alias unraidAgent='_agent_tmux unraidAgent /mnt/cache/cursor-workspace/unraid agent'
alias unraidAgent2='_agent_tmux unraidAgent2 /mnt/cache/cursor-workspace/unraid agent'
alias firewallAgent='_agent_tmux firewallAgent /mnt/cache/cursor-workspace/firewall agent'

# Claude agent — sysadmin workspaces on cache, each in its own tmux session
alias haClaude='_agent_tmux haClaude /mnt/cache/cursor-workspace/home-assistant claude'
alias unraidClaude='_agent_tmux unraidClaude /mnt/cache/cursor-workspace/unraid claude'
alias firewallClaude='_agent_tmux firewallClaude /mnt/cache/cursor-workspace/firewall claude'

# Codex agent - sysadmin workspaces on cache, each in its own tmux session
alias unraidCodex='_agent_tmux unraidCodex /mnt/cache/cursor-workspace/unraid codex --yolo'
alias firewallCodex='_agent_tmux firewallCodex /mnt/cache/cursor-workspace/firewall codex --yolo'
alias haCodex='_agent_tmux haCodex /mnt/cache/cursor-workspace/home-assistant codex --yolo'

agentLast() {
    local session="${1:?Usage: agentLast <tmux-session> [lines]}"
    local lines="${2:-500}"

    tmux capture-pane -p -S "-$lines" -t "$session" 2>/dev/null |
        less
}
alias fixUnraidAgent='tmux detach-client -s unraidAgent'
alias fixUnraidAgent2='tmux detach-client -s unraidAgent2'

source "$HOME/.homesick/repos/homeshick/homeshick.sh"
