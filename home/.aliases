PATH=$PATH:/mnt/user/src/scripts:$HOME/.homesick/repos/homeshick:$HOME/.local/bin
LS_COLORS='di=1;31:fi=0:ln=31:pi=5:so=5:bd=5:cd=5:or=37:mi=0:ex=35:ow=1;95:*.rpm=90'
export LS_COLORS

alias dir="ls -alh --group-directories-first --color"
alias dirm="ls -alh --group-directories-first --color | more"
alias dirt="ls -altrh --group-directories-first --color --time-style=+%D | grep $(date +%D)"
alias ll='ls -lhF --color=auto'
alias llt='ls -lht --color=auto'
alias lla='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias ls="ls --color=auto"
alias vinginx='vi /mnt/user/appdata/letsencrypt/nginx/site-confs/default'
alias vi='vim'
alias backupConfig='/boot/config/backup.sh'
alias import='docker exec -it beets bash /config/beets.sh '
alias ipconfig='nmcli device show | grep IP4'
alias checkvpn='/mnt/user/src/scripts/checkvpn'
alias docker-compose='docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$PWD:$PWD" \
    -w="$PWD" \
    docker/compose:latest'
alias importMusic='docker exec -it beets /config/beets.sh /downloads'
alias importSoulseek='docker exec -it beets /config/beets.sh /soulseek'
alias countDirs='ls -d */ |wc -l'
alias countFiles='find $1 -type f | wc -l'
alias soulseek='docker exec -it bash'
alias dockerstats='docker stats --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}"'
alias immich="docker run -it --rm -v $(pwd):/import ghcr.io/immich-app/immich-cli:latest"
alias duSpace='du -h --max-depth=1 '
alias movePorn='mv /mnt/user/downloads/youtube/* /mnt/user/other/'
alias immichImportDir="docker run -it --rm -v $1:/import ghcr.io/immich-app/immich-cli:latest upload --key jhNQduN0Bh2PF7IyCCfDuxIyEgtnxJOzSYduEPc --server https://images.YerADonkey.com/api"
alias immichImport="docker run -it --rm -v $(pwd):/import ghcr.io/immich-app/immich-cli:latest upload --key jhNQduN0Bh2PF7IyCCfDuxIyEgtnxJOzSYduEPc --server https://images.YerADonkey.com/api"

# tmux aliases

alias nsh='ssh user@server "bash --norc --noprofile"'
alias cockpit-reset='~/tmux-cockpit.sh'

# Unified AI launcher. It creates detached sessions and then switches the
# current tmux client, so nested tmux clients are never needed.
alias ai='/root/bin/ai-agent'

# Show recent output from an agent session without attaching to it.
agentLast() {
    local session="${1:?Usage: agentLast <tmux-session> [lines]}"
    local lines="${2:-500}"

    tmux capture-pane -p -S "-$lines" -t "$session" 2>/dev/null | less
}

# Compatibility names; all route through `ai` and preserve existing sessions.
alias haAgent='ai home-assistant cursor'
alias unraidAgent='ai unraid cursor'
alias unraidAgent2='ai unraid-secondary cursor'
alias overseerAgent='ai overseer cursor'
alias implementerAgent='ai implementer cursor'
alias firewallAgent='ai firewall cursor'
alias haCodex='ai home-assistant codex'
alias unraidCodex='ai unraid codex'
alias unraidCodex2='ai unraid-secondary codex'
alias firewallCodex='ai firewall codex'
alias fixHaAgent='ai --recover home-assistant cursor'
alias fixUnraidAgent='ai --recover unraid cursor'
alias fixUnraidAgent2='ai --recover unraid-secondary cursor'
alias fixOverseerAgent='ai --recover overseer cursor'
alias fixImplementerAgent='ai --recover implementer cursor'
alias fixFirewallAgent='ai --recover firewall cursor'
alias fixHaCodex='ai --recover home-assistant codex'
alias fixUnraidCodex='ai --recover unraid codex'
alias fixUnraidCodex2='ai --recover unraid-secondary codex'
alias fixFirewallCodex='ai --recover firewall codex'

# Setup command completion for tmux
_tmux_complete() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local prev=${COMP_WORDS[COMP_CWORD-1]}
  local cmd=${COMP_WORDS[1]}
  local usage word i
  local -a options=()
  COMPREPLY=()

  # tmux <Tab> — command names
  if (( COMP_CWORD == 1 )); then
    COMPREPLY=( $(compgen -W "$(tmux list-commands -F '#{command_list_name}')" -- "$cur") )
    return
  fi

  # tmux attach-session -t <Tab> — existing sessions
  if [[ $prev == -t && ( $cmd == attach || $cmd == attach-session ) ]]; then
    COMPREPLY=( $(compgen -W "$(tmux list-sessions -F '#S' 2>/dev/null)" -- "$cur") )
    return
  fi

  # tmux attach-session <Tab> — available flags
  if [[ -z $cur || $cur == -* ]]; then
    usage=$(tmux list-commands -F '#{command_list_usage}' "$cmd" 2>/dev/null) || return
    for word in $usage; do
      word=${word#\[}
      [[ $word == -* ]] || continue
      word=${word#-}
      word=${word//[^[:alnum:]]/}
      for ((i=0; i<${#word}; i++)); do
        options+=("-${word:i:1}")
      done
    done
    COMPREPLY=( $(compgen -W "${options[*]}" -- "$cur") )
  fi
}
complete -F _tmux_complete tmux
bind 'set show-all-if-ambiguous on'

source "$HOME/.homesick/repos/homeshick/homeshick.sh"
