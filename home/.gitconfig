[user]
	email = Squiggley@YerADonkey.com
	name = Unthred
[credential]
	helper = cache --timeout 3600
[url "git@github.com:"]
	insteadOf = https://github.com/
[alias]
	push = !git-safe push
	commit = !git-safe commit
	pull = !git-safe pull
[safe]
	directory = /mnt/cache/cursor-workspace/home-assistant/config-repo
	directory = /mnt/cache/cursor-workspace/unraid
[core]
	pager = cat
[credential "https://github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
